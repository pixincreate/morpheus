# Build scratch: the decoded APK tree and the intermediate APKs. Regenerated by
# scripts/build.sh, so it never belongs in the repository.
build/

# Compiled companion classes and the dex that gets packaged into the APK.
companion/classes/
companion/out/

# Signed splits produced by scripts/build.sh.
out/

# The untouched base APKs are large binaries. Keep them out of the repository and
# let anyone building from source supply their own copy in base/.
base/

# The signing key. Generate your own; never publish one. See the README.
keystore/
